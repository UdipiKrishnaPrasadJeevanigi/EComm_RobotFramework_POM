from ollama import chat as ollama_chat

MODEL_NAME = "qwen3:4b"

def add_message(message_list, role, text):
    message_list.append({
        "role": role,
        "content": text,
    })


def add_user_message(message_list, text):
    add_message(message_list, "user", text)


def add_assistant_message(message_list, text):
    add_message(message_list, "assistant", text)


def ask_ai(message_list, system_message, temperature):
    params = {
       "model": MODEL_NAME,
       "messages": message_list,
       "temperature": temperature,
       "stream": True
    }
    if system_message is not None:
        params["system"] = system_message
    response = ollama_chat(**params)
    return response.message.content


def chat():
    system_message = "You are a helpful assistant, give responses in one word."
    messages = []
    while True:
        user_input = input("Enter your message: ")
        if user_input.lower() == "exit":
            print("Exiting the chat.")
            break

        add_user_message(messages, user_input)
        response = ask_ai(messages, system_message, temperature=0.7)
        add_assistant_message(messages, response)

        
        print("Gemini:", response)

chat()

